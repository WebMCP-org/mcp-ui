{
  "name": "webmcp-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Demo showcasing MCP-UI + WebMCP integration with Tab Transport",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "vite-node src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mcp-ui/client": "workspace:*",
    "@mcp-ui/server": "workspace:*",
    "@mcp-b/transports": "^0.1.5",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^8.2.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^1.0.0"
  }
}
